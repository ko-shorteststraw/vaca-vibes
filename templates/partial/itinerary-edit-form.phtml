<div class="box has-background-light" id="itinerary-edit-<?=$item['id']?>"
     data-signals-edit-day="<?=(int)$item['day_number']?>"
     data-signals-edit-title="'<?=$this->e($item['title'])?>'"
     data-signals-edit-description="'<?=$this->e($item['description'] ?? '')?>'"
     data-signals-edit-time="'<?=$this->e($item['time'] ?? '')?>'"
     data-signals-edit-cost="'<?=number_format((float)$item['cost'], 2, '.', '')?>'">
    <div class="columns is-multiline">
        <div class="column is-2">
            <div class="field">
                <label class="label is-small">Day #</label>
                <input class="input is-small" type="number" min="1" data-bind-edit-day>
            </div>
        </div>
        <div class="column is-3">
            <div class="field">
                <label class="label is-small">Activity</label>
                <input class="input is-small" type="text" placeholder="Activity name" data-bind-edit-title>
            </div>
        </div>
        <div class="column is-3">
            <div class="field">
                <label class="label is-small">Description</label>
                <input class="input is-small" type="text" placeholder="Optional details" data-bind-edit-description>
            </div>
        </div>
        <div class="column is-1">
            <div class="field">
                <label class="label is-small">Time</label>
                <input class="input is-small" type="time" data-bind-edit-time>
            </div>
        </div>
        <div class="column is-1">
            <div class="field">
                <label class="label is-small">Cost</label>
                <input class="input is-small" type="number" step="0.01" min="0" data-bind-edit-cost>
            </div>
        </div>
        <div class="column is-2">
            <div class="field">
                <label class="label is-small">&nbsp;</label>
                <div class="buttons">
                    <button class="button is-success is-small"
                            data-on-click="@put('/api/itinerary/<?=$item['id']?>')">
                        Save
                    </button>
                    <button class="button is-small"
                            data-on-click="@get('/api/itinerary/<?=$item['id']?>/cancel')">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
