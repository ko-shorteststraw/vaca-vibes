<div class="modal is-active" id="vacation-modal">
    <div class="modal-background" data-on-click="@get('/')"></div>
    <div class="modal-card"
         data-signals-destination="'<?=$this->e($vacation['destination'] ?? '')?>'"
         data-signals-start-date="'<?=$this->e($vacation['start_date'] ?? '')?>'"
         data-signals-end-date="'<?=$this->e($vacation['end_date'] ?? '')?>'"
         data-signals-budget="'<?=$this->e($vacation['budget'] ?? '0')?>'"
         data-signals-notes="'<?=$this->e($vacation['notes'] ?? '')?>'"
         data-signals-image-url="'<?=$this->e($vacation['image_url'] ?? '')?>'">
        <header class="modal-card-head">
            <p class="modal-card-title"><?=$isEdit ? 'Edit Vacation' : 'New Vacation'?></p>
            <button class="delete" aria-label="close"
                    data-on-click="@get('<?=$isEdit ? '/vacation/' . $vacation['id'] : '/'?>')"></button>
        </header>
        <section class="modal-card-body">
            <div class="field">
                <label class="label">Destination</label>
                <div class="control">
                    <input class="input" type="text" placeholder="Where are you going?"
                           data-bind-destination required>
                </div>
            </div>
            <div class="columns">
                <div class="column">
                    <div class="field">
                        <label class="label">Start Date</label>
                        <div class="control">
                            <input class="input" type="date" data-bind-start-date
                                   data-on-change="document.getElementById('end-date-input').showPicker()">
                        </div>
                    </div>
                </div>
                <div class="column">
                    <div class="field">
                        <label class="label">End Date</label>
                        <div class="control">
                            <input class="input" type="date" data-bind-end-date id="end-date-input">
                        </div>
                    </div>
                </div>
            </div>
            <div class="field">
                <label class="label">Budget ($)</label>
                <div class="control">
                    <input class="input" type="number" step="0.01" min="0"
                           placeholder="0.00" data-bind-budget>
                </div>
            </div>
            <div class="field">
                <label class="label">Image URL</label>
                <div class="control">
                    <input class="input" type="url" placeholder="https://..."
                           data-bind-image-url>
                </div>
            </div>
            <div class="field">
                <label class="label">Notes</label>
                <div class="control">
                    <textarea class="textarea" placeholder="Any notes about this trip..."
                              data-bind-notes></textarea>
                </div>
            </div>
        </section>
        <footer class="modal-card-foot">
            <?php if ($isEdit): ?>
                <button class="button is-primary"
                        data-on-click="@put('/api/vacation/<?=$vacation['id']?>')">
                    Save Changes
                </button>
            <?php else: ?>
                <button class="button is-primary"
                        data-on-click="@post('/api/vacation')">
                    Create Vacation
                </button>
            <?php endif; ?>
            <button class="button"
                    data-on-click="@get('<?=$isEdit ? '/vacation/' . $vacation['id'] : '/'?>')">
                Cancel
            </button>
        </footer>
    </div>
</div>
