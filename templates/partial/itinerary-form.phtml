<div class="box has-background-light" id="itinerary-form"
     data-signals-itin-day="1"
     data-signals-itin-title="''"
     data-signals-itin-description="''"
     data-signals-itin-time="''"
     data-signals-itin-cost="'0'">
    <div class="columns is-multiline">
        <div class="column is-2">
            <div class="field">
                <label class="label is-small">Day #</label>
                <input class="input is-small" type="number" min="1" data-bind-itin-day>
            </div>
        </div>
        <div class="column is-3">
            <div class="field">
                <label class="label is-small">Activity</label>
                <input class="input is-small" type="text" placeholder="Activity name" data-bind-itin-title>
            </div>
        </div>
        <div class="column is-3">
            <div class="field">
                <label class="label is-small">Description</label>
                <input class="input is-small" type="text" placeholder="Optional details" data-bind-itin-description>
            </div>
        </div>
        <div class="column is-1">
            <div class="field">
                <label class="label is-small">Time</label>
                <input class="input is-small" type="time" data-bind-itin-time>
            </div>
        </div>
        <div class="column is-1">
            <div class="field">
                <label class="label is-small">Cost</label>
                <input class="input is-small" type="number" step="0.01" min="0" data-bind-itin-cost>
            </div>
        </div>
        <div class="column is-2">
            <div class="field">
                <label class="label is-small">&nbsp;</label>
                <button class="button is-primary is-small is-fullwidth"
                        data-on-click="@post('/api/vacation/<?=$vacationId?>/itinerary')">
                    Add
                </button>
            </div>
        </div>
    </div>
</div>
