<div class="box has-background-light" id="expense-form"
     data-signals-exp-description="''"
     data-signals-exp-amount="'0'"
     data-signals-exp-category="''">
    <div class="columns">
        <div class="column is-4">
            <div class="field">
                <label class="label is-small">Description</label>
                <input class="input is-small" type="text" placeholder="What did you spend on?" data-bind-exp-description>
            </div>
        </div>
        <div class="column is-2">
            <div class="field">
                <label class="label is-small">Amount ($)</label>
                <input class="input is-small" type="number" step="0.01" min="0" data-bind-exp-amount>
            </div>
        </div>
        <div class="column is-3">
            <div class="field">
                <label class="label is-small">Category</label>
                <div class="select is-small is-fullwidth">
                    <select data-bind-exp-category>
                        <option value="">Select...</option>
                        <option value="Food">Food</option>
                        <option value="Transport">Transport</option>
                        <option value="Accommodation">Accommodation</option>
                        <option value="Activities">Activities</option>
                        <option value="Shopping">Shopping</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="column is-3">
            <div class="field">
                <label class="label is-small">&nbsp;</label>
                <button class="button is-primary is-small is-fullwidth"
                        data-on-click="@post('/api/vacation/<?=$vacationId?>/expense')">
                    Add Expense
                </button>
            </div>
        </div>
    </div>
</div>
