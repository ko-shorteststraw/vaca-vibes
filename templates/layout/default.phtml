    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vacay Vibes - Vacation Planner</title>
    <script>(function(){var t=localStorage.getItem('theme');if(t==='dark'||(t!=='light'&&window.matchMedia('(prefers-color-scheme: dark)').matches))document.documentElement.classList.add('dark');})();</script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@1.0.2/css/bulma.min.css">
    <link rel="stylesheet" href="/css/theme.css">
    <script type="module" src="/datastar.js"></script>
</head>
<body>
    <nav class="navbar is-primary" role="navigation" aria-label="main navigation">
        <div class="navbar-brand">
            <a class="navbar-item has-text-weight-bold is-size-4" href="/">
                Vacay Vibes
            </a>
        </div>
        <div class="navbar-end">
            <div class="navbar-item">
                <button class="theme-toggle" onclick="let d=document.documentElement;d.classList.toggle('dark');localStorage.setItem('theme',d.classList.contains('dark')?'dark':'light')" title="Toggle dark mode">
                    <span class="theme-icon-light" style="display:none">&#9728;</span>
                    <span class="theme-icon-dark" style="display:none">&#9790;</span>
                </button>
                <script>
                (function(){
                    var isDark=document.documentElement.classList.contains('dark');
                    document.querySelector('.theme-icon-light').style.display=isDark?'inline':'none';
                    document.querySelector('.theme-icon-dark').style.display=isDark?'none':'inline';
                    var btn=document.querySelector('.theme-toggle');
                    var origClick=btn.onclick;
                    btn.onclick=function(){
                        origClick.call(this);
                        var d=document.documentElement.classList.contains('dark');
                        document.querySelector('.theme-icon-light').style.display=d?'inline':'none';
                        document.querySelector('.theme-icon-dark').style.display=d?'none':'inline';
                    };
                })();
                </script>
                <?php if (! empty($user)): ?>
                    <?php if (! empty($user['is_admin'])): ?>
                        <a href="/admin" class="button is-small is-warning mr-2">Admin</a>
                    <?php endif; ?>
                    <span class="mr-3">Logged in as <strong><?= $this->e($user['username']) ?></strong></span>
                    <form method="post" action="/logout" style="display:inline">
                        <button class="button is-small is-light" type="submit">Logout</button>
                    </form>
                <?php endif; ?>
            </div>
        </div>
